generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  phone         String?   @unique
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  firebaseUid   String?   @unique
  role          String    @default("VENDOR") // ADMIN, VENDOR, MODERATOR
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vendor        Vendor?
  apiKeys       ApiKey[]
  accounts      Account[]
  sessions      Session[]
  enterpriseUsers EnterpriseUser[]
}

model Vendor {
  id            String   @id @default(uuid())
  userId        String   @unique
  businessName  String?
  businessType  String?
  description   String?
  
  // Split Address Fields
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postalCode    String?
  country       String   @default("India")
  
  phone         String?
  email         String?
  website       String?
  logoUrl       String?
  
  status        String   @default("PENDING") // PENDING, ACTIVE, REJECTED, SUSPENDED
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id])
  documents     Document[]
  connections   PlatformConnection[]
  orders        Order[]
  products      Product[]
  webhooks      WebhookConfig[]
  enterpriseVendors EnterpriseVendor[]
  
  businessIdentity BusinessIdentity?
  sharingProfiles  SharingProfile[]
  sharedLinks      SharedLink[]
}

model Document {
  id            String   @id @default(uuid())
  vendorId      String
  type          String   // GST, PAN, BANK, AADHAR
  url           String
  
  // Metadata
  originalName  String?
  mimeType      String?
  size          Int?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vendor        Vendor   @relation(fields: [vendorId], references: [id])
  verification  Verification?
}

model Verification {
  id              String   @id @default(uuid())
  documentId      String   @unique
  status          String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  response        String?
  rejectionReason String?
  
  verifiedBy      String?
  verifiedAt      DateTime?
  
  updatedAt       DateTime @updatedAt

  document        Document @relation(fields: [documentId], references: [id])
}

model ApiKey {
  id        String   @id @default(uuid())
  userId    String
  key       String   @unique
  name      String
  plan      String   @default("free")
  usage     Int      @default(0)
  limit     Int      @default(50)
  lastUsed  DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}

model Platform {
  id          String   @id @default(uuid())
  name        String   @unique // swiggy, zomato, amazon, generic
  displayName String
  logoUrl     String?
  
  connections PlatformConnection[]
  orders      Order[]
  platformProducts PlatformProduct[]
}

model PlatformConnection {
  id          String   @id @default(uuid())
  vendorId    String
  platformId  String
  
  status      String   @default("LINKED") // LINKED, ACTIVE, FAILED
  externalId  String?  // ID on the external platform
  
  // Credentials (should be encrypted in production)
  accessToken String?
  apiKey      String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  platform  Platform @relation(fields: [platformId], references: [id])

  @@unique([vendorId, platformId])
}

model OtpSession {
  id            String    @id @default(uuid())
  identifier    String    @unique // email or phone
  code          String
  attempts      Int       @default(0)
  isUsed        Boolean   @default(false)
  lastAttemptAt DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
}

model Order {
  id              String      @id @default(uuid())
  vendorId        String
  platformId      String
  externalOrderId String      @unique
  status          String      @default("NEW") // NEW, CONFIRMED, PREPARING, READY, PICKED_UP, DELIVERED, CANCELLED
  orderType       String?     // DELIVERY, DINEOUT, PICKUP
  
  currency        String      @default("INR")
  subtotal        Float
  tax             Float
  deliveryFee     Float       @default(0)
  total           Float
  
  specialInstructions String?
  placedAt        DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  vendor          Vendor      @relation(fields: [vendorId], references: [id])
  platform        Platform    @relation(fields: [platformId], references: [id])
  customer        Customer?   @relation(fields: [customerId], references: [id])
  customerId      String?
  items           OrderItem[]
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  name      String
  quantity  Int
  price     Float
  options   String?  // JSON string for extra toppings etc.
  
  order     Order    @relation(fields: [orderId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
}

model Customer {
  id              String   @id @default(uuid())
  name            String?
  phone           String?
  deliveryAddress String?
  
  orders          Order[]
}

model Product {
  id              String      @id @default(uuid())
  vendorId        String
  name            String
  sku             String?
  description     String?
  price           Float
  stock           Int         @default(0)
  lowStockLevel   Int         @default(5)
  isActive        Boolean     @default(true)
  imageUrl        String?
  category        String?
  
  vendor          Vendor      @relation(fields: [vendorId], references: [id])
  orderItems      OrderItem[]
  platformMappings PlatformProduct[]
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([vendorId, name])
}

model PlatformProduct {
  id              String      @id @default(uuid())
  productId       String
  platformId      String
  externalId      String      // ID on the marketplace (e.g., Swiggy Item ID)
  externalName    String?     // Name on the marketplace
  isActive        Boolean     @default(true)
  
  product         Product     @relation(fields: [productId], references: [id])
  platform        Platform    @relation(fields: [platformId], references: [id])
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([platformId, externalId])
}

model WebhookConfig {
  id          String   @id @default(uuid())
  vendorId    String
  url         String   // Destination URL
  secret      String?  // For HMAC signing
  isActive    Boolean  @default(true)
  events      String   @default("ORDER_UPDATED,ITEM_OUT_OF_STOCK") // Comma separated events
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  logs        WebhookLog[]
}

model WebhookLog {
  id              String   @id @default(uuid())
  webhookConfigId String
  event           String
  payload         String   // JSON string
  statusCode      Int?
  responseBody    String?
  attempt         Int      @default(1)
  status          String   @default("SUCCESS") // SUCCESS, FAILED
  
  createdAt       DateTime @default(now())

  config          WebhookConfig @relation(fields: [webhookConfigId], references: [id])
}

model Webhook {
  id        String   @id @default(uuid())
  url       String
  createdAt DateTime @default(now())
}

model Payment {
  id        String   @id @default(uuid())
  orderId   String
  paymentId String
  plan      String
  createdAt DateTime @default(now())
}

model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}


model Enterprise {
  id          String   @id @default(uuid())
  name        String
  logoUrl     String?
  createdAt   DateTime @default(now())

  users       EnterpriseUser[]
  invitations EnterpriseInvitation[]
  vendors     EnterpriseVendor[]
}

model EnterpriseUser {
  id           String @id @default(uuid())
  userId       String
  enterpriseId String
  role         String // ADMIN, REVIEWER, VIEWER

  user       User       @relation(fields: [userId], references: [id])
  enterprise Enterprise @relation(fields: [enterpriseId], references: [id])
  
  @@unique([userId, enterpriseId])
}

model EnterpriseInvitation {
  id           String   @id @default(uuid())
  enterpriseId String
  businessName String
  email        String
  phone        String?
  message      String?
  status       String   @default("SENT") // SENT, ACCEPTED, EXPIRED, CANCELLED
  token        String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
}



model EnterpriseVendor {
  id           String @id @default(uuid())
  enterpriseId String
  vendorId     String
  status       String @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt    DateTime @default(now())

  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])
  vendor       Vendor     @relation(fields: [vendorId], references: [id])

  @@unique([enterpriseId, vendorId])
}


model BusinessIdentity {
  id              String   @id @default(uuid())
  vendorId        String   @unique
  businessId      String   @unique // VS-XXXXXXXX format
  profileDescription String?
  isPublic        Boolean  @default(false)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendor          Vendor   @relation(fields: [vendorId], references: [id])
}

model SharingProfile {
  id                String   @id @default(uuid())
  vendorId          String
  name              String   // e.g., "Public", "Enterprise", "Private"
  
  // Toggles for what to share
  shareBusinessDetails Boolean @default(true)
  shareGST             Boolean @default(false)
  sharePAN             Boolean @default(false) // Will be masked on client/server
  shareAddress         Boolean @default(true)
  shareContact         Boolean @default(false)
  shareDocuments       Boolean @default(false)
  shareCompliance      Boolean @default(true)
  shareCertificates    Boolean @default(false)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vendor            Vendor   @relation(fields: [vendorId], references: [id])
  sharedLinks       SharedLink[]
}

model SharedLink {
  id               String   @id @default(uuid())
  vendorId         String
  sharingProfileId String
  token            String   @unique // The secure share token
  
  linkType         String   @default("PERMANENT") // PERMANENT, 30_DAYS, 7_DAYS, SINGLE_USE
  expiresAt        DateTime?
  isActive         Boolean  @default(true)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vendor           Vendor         @relation(fields: [vendorId], references: [id])
  sharingProfile   SharingProfile @relation(fields: [sharingProfileId], references: [id])
  accessLogs       AccessLog[]
}

model AccessLog {
  id             String   @id @default(uuid())
  sharedLinkId   String
  
  accessorIp     String?
  organization   String?  // Name of the enterprise viewing it, if known
  purpose        String?  // Provided by the viewer or assumed
  
  accessedAt     DateTime @default(now())

  sharedLink     SharedLink @relation(fields: [sharedLinkId], references: [id])
}
